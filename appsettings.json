{

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "includeScopes": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Users/UmangChoudhary/source/Project/DiaAdmin/Service/SSRSPdfToImage/Logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithEnvironmentName" ],
    "Filter": [
      {
        "Name": "ByIncludingOnly",
        "Args": {
          "expression": "SourceContext = 'Microsoft' and @Level = 'Warning'"
        }
      }
    ]
  },
